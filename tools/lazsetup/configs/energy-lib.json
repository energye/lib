{
  "schema": 1,
  "_note": "Build modes MUST match <BuildModes><Item Name=...> in liblcl.lpi. Artifact names come from each mode's Target/Filename. 'ws' is REQUIRED for Linux/macOS: lazbuild needs --ws=gtk2/gtk3/cocoa to find the matching LCL units (the lpi's LCLWidgetType macro alone is not enough). Current liblcl.lpi references all third-party units through OtherUnitFiles (source dirs), so no lpk registration is needed; run `lazsetup doctor` after changing the .lpi. linux_GTK3 mirrors linux_GTK2 exactly (same lazbuild pipeline, same docker container, same package layout): the only build difference is --ws=gtk3 instead of --ws=gtk2. Old CI built GTK2 and GTK3 modes sequentially inside the SAME container; images are assigned per architecture (x86 debian:11, arm64 ubuntu:18.04), never per widgetset. It stays fully configured but disabled for now; re-enable it when the toolchain moves to Lazarus 5.0. No change to the lib source is needed.",
  "build": {
    "project": "liblcl.lpi",
    "workDir": ".",
    "containerDir": "${repo}",
    "outDir": "bins",
    "packages": [],
    "modes": [
      {
        "name": "win_amd64",
        "bm": "win_amd64",
        "os": ["windows"],
        "arch": ["amd64"],
        "artifact": "libenergy-amd64.dll",
        "output": "lcl_binary_windows64.zip"
      },
      {
        "name": "win_386",
        "bm": "win_386",
        "os": ["windows"],
        "arch": ["386"],
        "artifact": "libenergy-386.dll",
        "output": "lcl_binary_windows32.zip"
      },
      {
        "name": "linux_GTK2",
        "bm": "linux_GTK2",
        "ws": "gtk2",
        "os": ["linux"],
        "arch": ["386", "amd64", "arm", "arm64"],
        "artifact": "libenergy-gtk2.so",
        "output": "lcl_binary_${os}_${arch}_gtk2.zip"
      },
      {
        "name": "linux_GTK3",
        "bm": "linux_GTK3",
        "ws": "gtk3",
        "os": ["linux"],
        "arch": ["386", "amd64", "arm", "arm64"],
        "artifact": "libenergy-gtk3.so",
        "output": "lcl_binary_${os}_${arch}_gtk3.zip",
        "disabled": true
      },
      {
        "name": "darwin_amd64",
        "bm": "darwin_amd64",
        "ws": "cocoa",
        "os": ["darwin"],
        "arch": ["amd64"],
        "artifact": "libenergy-amd64.dylib",
        "output": "lcl_binary_macosx64.zip"
      },
      {
        "name": "darwin_arm64",
        "bm": "darwin_arm64",
        "ws": "cocoa",
        "os": ["darwin"],
        "arch": ["arm64"],
        "artifact": "libenergy-arm64.dylib",
        "output": "lcl_binary_macosarm64.zip",
        "extra": "--opt=-FD${repo}/tools/lazsetup/scripts/darwin-lld"
      },
      {
        "name": "Debug_CEF150",
        "bm": "Debug_CEF150",
        "artifact": "libenergy-${laz_target}.${lib_ext}",
        "output": "lcl_cef150_${os}_${arch}.zip",
        "disabled": true
      },
      {
        "name": "Debug_CEF147",
        "bm": "Debug_CEF147",
        "os": ["linux"],
        "artifact": "libenergy-${laz_target}.${lib_ext}",
        "output": "lcl_cef147_${os}_${arch}.zip",
        "disabled": true
      },
      {
        "name": "Debug_CEF127",
        "bm": "Debug_CEF127",
        "os": ["linux"],
        "artifact": "libenergy-${laz_target}.${lib_ext}",
        "output": "lcl_cef127_${os}_${arch}.zip",
        "disabled": true
      },
      {
        "name": "Debug_CEF109",
        "bm": "Debug_CEF109",
        "os": ["linux"],
        "artifact": "libenergy-${laz_target}.${lib_ext}",
        "output": "lcl_cef109_${os}_${arch}.zip",
        "disabled": true
      }
    ]
  }
}
