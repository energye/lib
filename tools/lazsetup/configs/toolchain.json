{
  "schema": 1,
  "vars": {
    "LAZ_MIRROR": "https://download.lazarus-ide.org",
    "FPC_CDN": "https://downloads.freepascal.org/fpc/dist",
    "SF_LAZ": "https://sourceforge.net/projects/lazarus/files",
    "SF_FPC": "https://sourceforge.net/projects/freepascal/files",
    "SF_LAZ_DL": "https://downloads.sourceforge.net/project/lazarus",
    "SF_FPC_DL": "https://downloads.sourceforge.net/project/freepascal",
    "SF_LAZ_M": "https://master.dl.sourceforge.net/project/lazarus",
    "SF_FPC_M": "https://master.dl.sourceforge.net/project/freepascal"
  },
  "defaults": {
    "lazarus": "4.8",
    "work": "${home}/.lazsetup",
    "prefix": "${work}/lazarus",
    "cache": "${home}/.cache/lazsetup",
    "retries": 3,
    "timeout": "30m"
  },
  "releases": {
    "4.8": {
      "fpc": "3.2.2",
      "aliases": {
        "laz_src": "lazarus-4.8-0.tar.gz",
        "laz_win": "lazarus-4.8-fpc-3.2.2-${win_tag}.exe",
        "laz_mac_zip": "lazarus-darwin-${mac_arch}-4.8.zip",
        "mac_fpc_dmg": "fpc-3.2.4rc1a.intelarm64-macosx.dmg"
      }
    },
    "4.0": {
      "fpc": "3.2.2",
      "aliases": {
        "laz_src": "lazarus-4.0-0.tar.gz",
        "laz_win": "lazarus-4.0-fpc-3.2.2-${win_tag}.exe",
        "laz_mac_zip": "lazarus-darwin-${mac_arch}-4.0.zip",
        "mac_fpc_dmg": "fpc-3.2.2.intelarm64-macosx.dmg"
      }
    },
    "3.8": {
      "fpc": "3.2.2",
      "aliases": {
        "laz_src": "lazarus-3.8-0.tar.gz",
        "laz_win": "lazarus-3.8-fpc-3.2.2-${win_tag}.exe",
        "laz_mac_zip": "lazarus-darwin-${mac_arch}-3.8.zip",
        "mac_fpc_dmg": "fpc-3.2.2.intelarm64-macosx.dmg"
      }
    }
  },
  "profiles": {
    "win-binary": {
      "os": ["windows"],
      "arch": ["386", "amd64"],
      "components": [
        {
          "id": "lazarus",
          "url": "${LAZ_MIRROR}/Lazarus%20Windows%20${win_bits}%20bits/Lazarus%20${laz}/${laz_win}",
          "urls": [
            "${SF_LAZ}/Lazarus%20Windows%20${win_bits}%20bits/Lazarus%20${laz}/${laz_win}/download",
            "${SF_LAZ_DL}/Lazarus%20Windows%20${win_bits}%20bits/Lazarus%20${laz}/${laz_win}",
            "${SF_LAZ_M}/Lazarus%20Windows%20${win_bits}%20bits/Lazarus%20${laz}/${laz_win}"
          ],
          "kind": "inno",
          "dest": "${prefix}",
          "provides": ["lazbuild.exe", "fpc.exe"]
        }
      ]
    },
    "linux-source": {
      "os": ["linux"],
      "arch": ["386", "amd64", "arm", "arm64"],
      "components": [
        {
          "id": "lazarus-src",
          "url": "${LAZ_MIRROR}/Lazarus%20Zip%20_%20GZip/Lazarus%20${laz}/${laz_src}",
          "urls": [
            "${SF_LAZ}/Lazarus%20Zip%20_%20GZip/Lazarus%20${laz}/${laz_src}/download",
            "${SF_LAZ_DL}/Lazarus%20Zip%20_%20GZip/Lazarus%20${laz}/${laz_src}"
          ],
          "kind": "targz",
          "dest": "${prefix}",
          "strip": 1
        },
        {
          "id": "fpc-bin",
          "url": "${FPC_CDN}/${fpc}/${fpc_arch}-linux/fpc-${fpc}.${fpc_arch}-linux.tar",
          "urls": [
            "${SF_FPC}/Linux/${fpc}/fpc-${fpc}.${fpc_arch}-linux.tar/download",
            "${SF_FPC_DL}/Linux/${fpc}/fpc-${fpc}.${fpc_arch}-linux.tar"
          ],
          "kind": "tar",
          "dest": "${prefix}",
          "strip": 0
        },
        {
          "id": "fpcsrc",
          "url": "${FPC_CDN}/${fpc}/source/fpc-${fpc}.source.tar.gz",
          "urls": [
            "${SF_FPC}/Source/${fpc}/fpc-${fpc}.source.tar.gz/download",
            "${SF_FPC_DL}/Source/${fpc}/fpc-${fpc}.source.tar.gz"
          ],
          "kind": "targz",
          "dest": "${prefix}",
          "strip": 0
        },
        {
          "id": "build-fpc",
          "kind": "commands",
          "commands": [
            "cd \"${cprefix}/fpc-${fpc}.${fpc_suffix}\" && printf \"\\n\\n\\n\\n\\n\\n\" | ./install.sh"
          ]
        },
        {
          "id": "build-lazarus",
          "kind": "commands",
          "commands": [
            "cd \"${cprefix}\" && make clean all"
          ]
        }
      ]
    },
    "mac-binary": {
      "os": ["darwin"],
      "arch": ["amd64", "arm64"],
      "components": [
        {
          "id": "fpc",
          "url": "${LAZ_MIRROR}/Lazarus%20macOS%20${mac_dir}/Lazarus%20${laz}/${mac_fpc_dmg}",
          "urls": [
            "${SF_LAZ}/Lazarus%20macOS%20${mac_dir}/Lazarus%20${laz}/${mac_fpc_dmg}/download",
            "${SF_LAZ_DL}/Lazarus%20macOS%20${mac_dir}/Lazarus%20${laz}/${mac_fpc_dmg}"
          ],
          "kind": "dmg",
          "sudo": true
        },
        {
          "id": "lazarus",
          "url": "${LAZ_MIRROR}/Lazarus%20macOS%20${mac_dir}/Lazarus%20${laz}/${laz_mac_zip}",
          "urls": [
            "${SF_LAZ}/Lazarus%20macOS%20${mac_dir}/Lazarus%20${laz}/${laz_mac_zip}/download",
            "${SF_LAZ_DL}/Lazarus%20macOS%20${mac_dir}/Lazarus%20${laz}/${laz_mac_zip}"
          ],
          "kind": "zip",
          "dest": "${prefix}",
          "commands": [
            "xattr -cr \"${prefix}\" 2>/dev/null || true",
            "LAZ=$(find \"${prefix}\" -maxdepth 4 -type f -name lazbuild 2>/dev/null | head -1) && test -n \"$LAZ\" && sudo mkdir -p /usr/local/bin && sudo ln -sfn \"$LAZ\" /usr/local/bin/lazbuild"
          ]
        }
      ]
    }
  },
  "targets": {
    "windows/386": { "profile": "win-binary" },
    "windows/amd64": { "profile": "win-binary" },
    "linux/386": {
      "profile": "linux-source",
      "container": {
        "engine": "docker",
        "image": "i386/debian:11",
        "platform": "linux/386",
        "hostPath": "${repo}",
        "guestPath": "/app",
        "prefixGuest": "/toolchain",
        "mounts": [
          { "host": "${prefix}", "guest": "/toolchain" }
        ],
        "workdir": "/app",
        "shell": "/bin/sh",
        "install": [
          "apt-get update -q -y",
          "DEBIAN_FRONTEND=noninteractive apt-get install -q -y --no-install-recommends make binutils build-essential zip unzip libx11-dev libgtk2.0-dev libcairo2-dev libpango1.0-dev libgtk-3-dev",
          "apt-get install -q -y --no-install-recommends libgdk-pixbuf2.0-dev || apt-get install -q -y --no-install-recommends libgdk-pixbuf-2.0-dev"
        ]
      }
    },
    "linux/amd64": {
      "profile": "linux-source",
      "container": {
        "engine": "docker",
        "image": "amd64/debian:11",
        "platform": "linux/amd64",
        "name": "lazsetup-${os}-${arch}",
        "hostPath": "${repo}",
        "guestPath": "/app",
        "prefixGuest": "/toolchain",
        "mounts": [
          { "host": "${prefix}", "guest": "/toolchain" }
        ],
        "workdir": "/app",
        "shell": "/bin/sh",
        "install": [
          "apt-get update -q -y",
          "DEBIAN_FRONTEND=noninteractive apt-get install -q -y --no-install-recommends make binutils build-essential zip unzip libx11-dev libgtk2.0-dev libcairo2-dev libpango1.0-dev libgtk-3-dev",
          "apt-get install -q -y --no-install-recommends libgdk-pixbuf2.0-dev || apt-get install -q -y --no-install-recommends libgdk-pixbuf-2.0-dev"
        ]
      }
    },
    "linux/arm": {
      "profile": "linux-source",
      "container": {
        "engine": "docker",
        "image": "arm32v7/debian:11",
        "platform": "linux/arm/v7",
        "hostPath": "${repo}",
        "guestPath": "/app",
        "prefixGuest": "/toolchain",
        "mounts": [
          { "host": "${prefix}", "guest": "/toolchain" }
        ],
        "workdir": "/app",
        "shell": "/bin/sh",
        "install": [
          "apt-get update -q -y",
          "DEBIAN_FRONTEND=noninteractive apt-get install -q -y --no-install-recommends make binutils build-essential zip unzip libx11-dev libgtk2.0-dev libcairo2-dev libpango1.0-dev libgtk-3-dev",
          "apt-get install -q -y --no-install-recommends libgdk-pixbuf2.0-dev || apt-get install -q -y --no-install-recommends libgdk-pixbuf-2.0-dev"
        ]
      }
    },
    "linux/arm64": {
      "profile": "linux-source",
      "container": {
        "engine": "docker",
        "image": "arm64v8/ubuntu:18.04",
        "platform": "linux/arm64",
        "hostPath": "${repo}",
        "guestPath": "/app",
        "prefixGuest": "/toolchain",
        "mounts": [
          { "host": "${prefix}", "guest": "/toolchain" }
        ],
        "workdir": "/app",
        "shell": "/bin/sh",
        "install": [
          "apt-get update -q -y",
          "DEBIAN_FRONTEND=noninteractive apt-get install -q -y --no-install-recommends make binutils build-essential zip unzip libx11-dev libgtk2.0-dev libcairo2-dev libpango1.0-dev libgtk-3-dev",
          "apt-get install -q -y --no-install-recommends libgdk-pixbuf2.0-dev || apt-get install -q -y --no-install-recommends libgdk-pixbuf-2.0-dev"
        ]
      }
    },
    "darwin/amd64": { "profile": "mac-binary" },
    "darwin/arm64": {
      "profile": "mac-binary",
      "note": "官方 aarch64 zip; 若需 FPC 3.3.1 trunk 请另配 profile (见 DESIGN.md)"
    }
  }
}
